            "url": {
              "raw": "{{baseUrl}}/infygo/book/{{flightId}}/{{userId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengers\": [\n    {\n      \"passengerName\": \"Asha Kumar\",\n      \"passengerAge\": 34,\n      \"passengerGender\": \"Female\"\n    }\n  ]\n}"
