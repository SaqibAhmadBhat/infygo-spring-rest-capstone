    {
      "name": "3. Booking",
      "item": [
        {
          "name": "Book (matrix parameters)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/infygo/book/tickets;flightId={{flightId}};userId={{userId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengers\": [\n    {\n      \"passengerName\": \"Asha Kumar\",\n      \"passengerAge\": 34,\n      \"passengerGender\": \"Female\"\n    },\n    {\n      \"passengerName\": \"Ravi Kumar\",\n      \"passengerAge\": 36,\n      \"passengerGender\": \"Male\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.test('Seats = passengers', () => pm.expect(t.noOfSeats).to.eql(2));",
                  "pm.collectionVariables.set('pnr', t.pnr);",
                  "pm.collectionVariables.set('totalFare', t.totalFare);"
                ]
              }
            }
          ]
        },
        {
          "name": "Book (path-segment form)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
