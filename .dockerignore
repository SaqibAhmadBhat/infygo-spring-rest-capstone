# .dockerignore — exclude files not needed inside the Docker build context
# This speeds up the build and avoids leaking secrets into the image.

# Git metadata
.git
.gitignore
.gitattributes

# IDE and editor files
.idea
.vscode
*.iml

# Maven compiled output (rebuilt inside Docker)
target/

# Environment files (never copy secrets into image)
.env
.env.*
!.env.example

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml

# Presentation / frontend assets (not part of the backend image)
presentation/

# Documentation and tests (not needed at runtime)
docs/
postman/
database/

# Scratch / temp files
*.log
*.tmp
_to_delete/

