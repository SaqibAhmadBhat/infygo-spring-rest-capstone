{
  "info": {
    "name": "InfyGo Spring REST Capstone",
    "description": "Run folders in order. Base URL includes the mandatory /InfyGo context path. Demo flights are seeded automatically. Payment uses synthetic card data only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// journeyDate defaults to today + 3 days (a seeded demo date); cardYear to next year.",
          "if (!pm.collectionVariables.get('journeyDate')) {",
          "  const d = new Date(); d.setDate(d.getDate() + 3);",
          "  const pad = n => String(n).padStart(2, '0');",
          "  pm.collectionVariables.set('journeyDate', d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()));",
          "}",
          "pm.collectionVariables.set('cardYear', String(new Date().getFullYear() + 1));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/InfyGo"
    },
    {
      "key": "journeyDate",
      "value": ""
    },
    {
      "key": "password",
      "value": "Demo@Pass#2026"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "flightId",
      "value": ""
    },
    {
      "key": "pnr",
      "value": ""
    },
    {
      "key": "totalFare",
      "value": ""
    },
    {
      "key": "cardYear",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Registration & login",
      "item": [
        {
          "name": "Register (valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/infygo/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"name\": \"Asha Kumar\",\n  \"city\": \"Chennai\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now() % 1000000;",
                  "pm.collectionVariables.set('userId', 'demo' + n);",
                  "pm.collectionVariables.set('email', 'demo' + n + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('No password in response', () => pm.expect(pm.response.json()).to.not.have.property('password'));"
                ]
              }
            }
          ]
        },
